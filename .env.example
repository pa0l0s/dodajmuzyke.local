DODAJMUZYKE_MUSIC_DIR=/music
DODAJMUZYKE_WORK_DIR=/downloads
DODAJMUZYKE_DATABASE_PATH=/downloads/dodajmuzyke.sqlite3
DODAJMUZYKE_PUBLIC_BASE_URL=http://dodajmuzyke.local
# Optional in custom deployments; docker-compose.yml provides this sidecar URL.
DODAJMUZYKE_POT_PROVIDER_URL=http://bgutil-provider:4416
# Optional: improves acoustic fingerprint matching. Do not commit real secrets.
# DODAJMUZYKE_ACOUSTID_API_KEY=
# DODAJMUZYKE_MUSICBRAINZ_USER_AGENT=dodajmuzyke/1.0 (your-email-or-instance)
